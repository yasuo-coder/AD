{
    "gpu": {
        "use": true,
        "id": 0
    },
    "model": "fTSPL",
    "dataset": "abide_full_AAL116",
    "out_dir": "out/baselines/fTSPL/abide_full_AAL116/",
    "params": {
        "seed": 41,
        "epochs": 1000,
        "batch_size": 20,
        "init_lr": 5e-05,
        "lr_reduce_factor": 0.5,
        "lr_schedule_patience": 25,
        "min_lr": 1e-06,
        "weight_decay": 0.005,
        "print_epoch_interval": 5,
        "max_time": 12,
        "node_feat_transform": "pearson",
        "edge_ratio": 0.2,
        "threshold": 0.3
    },
    "net_params": {
        "L": 4,
        "hidden_dim": 116,
        "out_dim": 116,
        "residual": true,
        "readout": "mean",
        "in_feat_dropout": 0.0,
        "dropout": 0.0,
        "batch_norm": true,
        "self_loop": false,
        "edge_feat": true,
        "ftspl_time_steps": 128,
        "ftspl_prompt_depth": 4,
        "ftspl_prompt_length": 2,
        "ftspl_activation_fraction": 0.6,
        "ftspl_correlation_count": 5,
        "ftspl_temperature": 0.07,
        "ftspl_contrast_weight": 0.5,
        "ftspl_task_weight": 0.5,
        "ftspl_pretrained_path": null,
        "ftspl_context_length": 256
    },
    "implementation": "paper_reconstruction"
}
