{
    "gpu": {
        "use": true,
        "id": 0
    },
    "model": "BrainNetCNN",
    "dataset": "adni_custom_AAL116",
    "views": [
        "adni_AAL116"
    ],
    "out_dir": "out/baselines/BrainNetCNN/adni_custom_AAL116/",
    "params": {
        "seed": 41,
        "epochs": 1000,
        "batch_size": 20,
        "init_lr": 0.0007,
        "lr_reduce_factor": 0.5,
        "lr_schedule_patience": 25,
        "min_lr": 1e-06,
        "weight_decay": 0.0,
        "print_epoch_interval": 5,
        "max_time": 12,
        "node_feat_transform": "pearson",
        "edge_ratio": 0.2
    },
    "net_params": {
        "hidden_dim": 64,
        "out_dim": 256
    },
    "label_policy": "mci_to_lmci_v1"
}
