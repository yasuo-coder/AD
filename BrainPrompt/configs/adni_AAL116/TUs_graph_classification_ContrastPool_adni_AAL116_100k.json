{
    "gpu": {
        "use": true,
        "id": 0
    },
    "model": "ContrastPool",
    "dataset": "adni_AAL116",
    "out_dir": "out/baselines/ContrastPool/adni_AAL116/",
    "params": {
        "seed": 41,
        "epochs": 1000,
        "batch_size": 20,
        "init_lr": 5e-05,
        "lr_reduce_factor": 0.5,
        "lr_schedule_patience": 25,
        "min_lr": 1e-06,
        "weight_decay": 0.005,
        "print_epoch_interval": 5,
        "max_time": 12,
        "node_feat_transform": "pearson",
        "edge_ratio": 0.2,
        "threshold": 0.3
    },
    "net_params": {
        "L": 3,
        "hidden_dim": 116,
        "out_dim": 116,
        "residual": true,
        "readout": "mean",
        "in_feat_dropout": 0.0,
        "dropout": 0.0,
        "batch_norm": true,
        "self_loop": false,
        "edge_feat": false,
        "pool_ratio": 0.5,
        "contrast_entropy_weight": 0.001,
        "contrast_max_references": 0
    },
    "implementation": "adapted_baseline",
    "label_policy": "mci_to_lmci_v1"
}
